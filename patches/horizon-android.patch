+[package]
+name = "horizon-android"
+version = "0.1.0"
+edition.workspace = true
+license.workspace = true
+rust-version = "1.90"
+description = "Android GameActivity entry point for Horizon"
+
+[lib]
+name = "main"
+crate-type = ["cdylib"]
+
+[dependencies]
+horizon-client = { path = "../horizon-client", default-features = false }
+horizon-threads = { path = "../horizon-threads" }
+serde = { version = "1", features = ["derive"] }
+serde_json = "1.0.151"
+winit = { version = "0.30.13", default-features = false, features = ["android-game-activity"] }
+
+[features]
+# Audio uses CPAL's Android AAudio path (API 26+). Keep it opt-in at build
+# time while lifecycle/audio-focus validation is completed on hardware.
+default = []
+audio = ["horizon-client/audio"]
diff --git a/crates/horizon-android/src/lib.rs b/crates/horizon-android/src/lib.rs
new file mode 100644
index 0000000..4111a8f
--- /dev/null
+++ b/crates/horizon-android/src/lib.rs
@@ -0,0 +1,174 @@
+//! Android entry point for the Horizon Rust client.
+//!
+//! Kotlin writes a short-lived, app-private launch description before opening
+//! `GameActivity`. The game itself remains Horizon's Rust client; this crate
+//! only binds Android's lifecycle to Winit and translates that description to
+//! the existing command-line launch API.
+
+#[cfg(target_os = "android")]
+use std::{
+    fs,
+    path::{Path, PathBuf},
+};
+
+#[cfg(target_os = "android")]
+use winit::platform::android::activity::AndroidApp;
+
+#[cfg(target_os = "android")]
+#[derive(serde::Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct LaunchConfig {
+    game_dir: PathBuf,
+    resources_dir: PathBuf,
+    home_dir: PathBuf,
+    control_endpoint: PathBuf,
+    render_distance: u8,
+}
+
+#[cfg(target_os = "android")]
+#[derive(serde::Serialize)]
+struct RunResult<'a> {
+    state: &'a str,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    message: Option<&'a str>,
+    #[serde(rename = "updatedAtMillis")]
+    updated_at_millis: u64,
+}
+
+// The desktop executable owns this allocator normally.  A cdylib has no
+// `horizon-client` binary linked into it, so Android must install it here.
+#[global_allocator]
+static ALLOCATOR: horizon_threads::Allocator = horizon_threads::Allocator;
+
+/// Android's GameActivity glue calls this from its native lifecycle thread.
+#[cfg(target_os = "android")]
+#[unsafe(no_mangle)]
+pub fn android_main(app: AndroidApp) {
+    let result_file = app
+        .internal_data_path()
+        .map(|dir| dir.join("horizon/runtime-status.json"));
+    write_run_result(result_file.as_deref(), "running", None);
+    if let Err(error) = start(app) {
+        eprintln!("Horizon Android failed to start: {error}");
+        let message = error.to_string();
+        write_run_result(result_file.as_deref(), "failed", Some(&message));
+    } else {
+        write_run_result(result_file.as_deref(), "completed", None);
+    }
+}
+
+#[cfg(target_os = "android")]
+fn start(app: AndroidApp) -> horizon_client::Result<()> {
+    horizon_threads::configure_allocator();
+    let internal_root = app
+        .internal_data_path()
+        .ok_or("Android did not supply an internal data directory")?;
+    // GameActivity's `internalDataPath` is Android's `Context.filesDir`;
+    // unlike the package data root it already ends in `/files`.
+    let launch_file = internal_root.join("horizon/active-launch.json");
+    let config: LaunchConfig = serde_json::from_slice(&fs::read(&launch_file)?)?;
+    prepare_paths(&internal_root, &config)?;
+
+    // The desktop binary normally does this before `game::run`. Android does
+    // the same setup here, using only app-private paths supplied by Kotlin.
+    horizon_client::logging::set_game_home(config.home_dir.clone());
+    horizon_client::logging::init(&config.home_dir, "Render thread");
+    horizon_client::crash::install(config.home_dir.clone(), "client");
+    horizon_client::telemetry::mark_start();
+
+    let args = vec![
+        "--game-dir".into(),
+        path_arg(&config.game_dir),
+        "--resources".into(),
+        path_arg(&config.resources_dir),
+        "--home".into(),
+        path_arg(&config.home_dir),
+        "--control-socket".into(),
+        path_arg(&config.control_endpoint),
+        "--render-distance".into(),
+        config.render_distance.to_string(),
+        "--fullscreen".into(),
+    ];
+    let result = horizon_client::game::run_android(app, args);
+    if let Err(error) = &result {
+        horizon_client::crash::report_error(&config.home_dir, "client", &**error);
+    }
+    horizon_client::logging::flush();
+    result
+}
+
+#[cfg(target_os = "android")]
+fn prepare_paths(internal_root: &Path, config: &LaunchConfig) -> std::io::Result<()> {
+    for (name, path) in [
+        ("gameDir", &config.game_dir),
+        ("resourcesDir", &config.resources_dir),
+        ("homeDir", &config.home_dir),
+        ("controlEndpoint", &config.control_endpoint),
+    ] {
+        if !path.is_absolute() || !path.starts_with(internal_root) {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                format!("{name} must be an absolute path inside filesDir"),
+            ));
+        }
+    }
+    fs::create_dir_all(&config.game_dir)?;
+    fs::create_dir_all(&config.home_dir)?;
+    if !config.resources_dir.join("horizon-resources.json").is_file() {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::NotFound,
+            format!(
+                "prepared resources missing (no horizon-resources.json): {}",
+                config.resources_dir.display()
+            ),
+        ));
+    }
+    if let Some(parent) = config.control_endpoint.parent() {
+        fs::create_dir_all(parent)?;
+    }
+    // Android is a Unix target, so force the JSON/TCP endpoint that Kotlin's
+    // loopback bridge understands instead of a Unix-domain socket.
+    if !horizon_client::control::uses_tcp(&config.control_endpoint) {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            "controlEndpoint must end in .json on Android",
+        ));
+    }
+    Ok(())
+}
+
+#[cfg(target_os = "android")]
+fn path_arg(path: &Path) -> String {
+    path.to_string_lossy().into_owned()
+}
+
+/// Writes a tiny, atomically replaced result file for the Kotlin host.  The
+/// activity should clear a previous result before launch and finish itself
+/// after it observes `completed` or `failed`; returning from `android_main`
+/// intentionally lets GameActivity unwind rather than killing the process.
+#[cfg(target_os = "android")]
+fn write_run_result(path: Option<&Path>, state: &str, message: Option<&str>) {
+    let Some(path) = path else { return };
+    let Some(parent) = path.parent() else { return };
+    if fs::create_dir_all(parent).is_err() {
+        return;
+    }
+    let updated_at_millis = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |elapsed| elapsed.as_millis() as u64);
+    let Ok(json) = serde_json::to_vec(&RunResult {
+        state,
+        message,
+        updated_at_millis,
+    }) else {
+        return;
+    };
+    let temporary = path.with_extension("tmp");
+    if fs::write(&temporary, json).is_ok() {
+        let _ = fs::rename(temporary, path);
+    }
+}
+
+// Allows `cargo check -p horizon-android` on a desktop development machine.
+#[cfg(not(target_os = "android"))]
+pub fn desktop_placeholder() {}
