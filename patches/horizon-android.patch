+impl Game<'_> {
+    /// Android invalidates the native window beneath Winit on every
+    /// `SurfaceView` termination. Keep the game state, but drop the renderer's
+    /// surface until the following `resumed` callback creates a new one.
+    fn suspend_for_android(&mut self, event_loop: &ActiveEventLoop) {
+        #[cfg(target_os = "android")]
+        {
+            if self.android_suspended {
+                event_loop.set_control_flow(ControlFlow::Wait);
+                return;
+            }
+            self.android_suspended = true;
+
+            // GameActivity can destroy its SurfaceView before a release
+            // reaches the local control socket. Do not leave movement, mining
+            // or a virtual pad pressed while the Android activity is away.
+            self.focused = false;
+            self.focus_lost = Some(Instant::now());
+            self.physical_keys.clear();
+            self.physical_buttons.clear();
+            self.keys.clear();
+            self.left = false;
+            self.right = false;
+            self.toggles = Default::default();
+            self.mouse = MouseLook::default();
+            self.android_menu_touch = None;
+            self.capture(false);
+            self.release_pad_for_suspend(event_loop);
+
+            // A running integrated server is independent of redraws. Pause it
+            // explicitly; its next server tick performs the usual async
+            // autosave. A no-server-thread local world needs the equivalent
+            // save on this game thread instead.
+            self.pause = true;
+            self.clock.end_frame(true);
+            if let Some(server) = &self.integrated {
+                server.set_paused(true);
+            }
+            if let Some(starting) = &self.integrated_starting {
+                starting.set_paused(true);
+            }
+            if self.integrated.is_none()
+                && self.remote.is_none()
+                && self.title.is_none()
+                && !self.world_root.as_os_str().is_empty()
+                && let Err(error) = self.save_game_with(false)
+            {
+                log::warn!("Horizon: Android suspend autosave: {error}");
+            }
+
+            if let Some(renderer) = &mut self.renderer {
+                renderer.drop_surface_for_suspend();
+            }
+            // The Android backend cannot deliver a useful redraw while its
+            // SurfaceView is gone. Waiting also keeps an outstanding control
+            // request from turning the event loop into a busy spin.
+            event_loop.set_control_flow(ControlFlow::Wait);
+        }
+        #[cfg(not(target_os = "android"))]
+        let _ = event_loop;
+    }
+}
